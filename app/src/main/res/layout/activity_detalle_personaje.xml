<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/umbra_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            style="@style/UmbraTitulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:fontFamily="serif"
            android:gravity="center"
            android:letterSpacing="0.15"
            android:text="@string/app_name"
            android:textSize="32sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginBottom="24dp"
            android:background="@color/umbra_border" />

        <LinearLayout
            android:id="@+id/contenidoDetalle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/umbra_card_background"
                android:orientation="vertical"
                android:padding="20dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="280dp"
                    android:layout_marginBottom="20dp"
                    android:background="@drawable/umbra_card_background"
                    android:clipToOutline="true">

                    <TextView
                        android:id="@+id/txtInicialesDetalle"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@color/umbra_surface_variant"
                        android:fontFamily="serif"
                        android:gravity="center"
                        android:importantForAccessibility="no"
                        android:textColor="@color/umbra_primary"
                        android:textSize="52sp" />

                    <ImageView
                        android:id="@+id/imgPersonajeDetalle"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@null"
                        android:scaleType="fitCenter"
                        android:visibility="invisible" />
                </FrameLayout>

                <TextView
                    android:id="@+id/txtNombreDetalle"
                    style="@style/UmbraTitulo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="serif"
                    android:gravity="center"
                    android:textSize="30sp" />

                <TextView
                    android:id="@+id/txtClaseRazaDetalle"
                    style="@style/UmbraTexto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center" />

                <TextView
                    android:id="@+id/txtNivelDetalle"
                    style="@style/UmbraTextoSecundario"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/umbra_card_background"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    style="@style/UmbraSubtitulo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="serif"
                    android:text="@string/detalle_historia"
                    android:textColor="@color/umbra_primary" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp"
                    android:background="@color/umbra_border" />

                <TextView
                    android:id="@+id/txtHistoriaDetalle"
                    style="@style/UmbraTexto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="5dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/umbra_card_background"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    style="@style/UmbraSubtitulo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="serif"
                    android:text="@string/detalle_personalidad"
                    android:textColor="@color/umbra_primary" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp"
                    android:background="@color/umbra_border" />

                <TextView
                    android:id="@+id/txtPersonalidadDetalle"
                    style="@style/UmbraTexto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="5dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/umbra_card_background"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    style="@style/UmbraSubtitulo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="serif"
                    android:text="@string/detalle_estadisticas"
                    android:textColor="@color/umbra_primary" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp"
                    android:background="@color/umbra_border" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:background="@color/umbra_surface_variant"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:id="@+id/txtFuerzaDetalle"
                            style="@style/UmbraTitulo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:textSize="24sp" />

                        <TextView
                            style="@style/UmbraTextoSecundario"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:labelFor="@id/txtFuerzaDetalle"
                            android:text="@string/detalle_fuerza" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@color/umbra_surface_variant"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:id="@+id/txtDestrezaDetalle"
                            style="@style/UmbraTitulo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:textSize="24sp" />

                        <TextView
                            style="@style/UmbraTextoSecundario"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:labelFor="@id/txtDestrezaDetalle"
                            android:text="@string/detalle_destreza" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:background="@color/umbra_surface_variant"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:id="@+id/txtInteligenciaDetalle"
                            style="@style/UmbraTitulo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:textSize="24sp" />

                        <TextView
                            style="@style/UmbraTextoSecundario"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:labelFor="@id/txtInteligenciaDetalle"
                            android:text="@string/detalle_inteligencia" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@color/umbra_surface_variant"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:id="@+id/txtCarismaDetalle"
                            style="@style/UmbraTitulo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:textSize="24sp" />

                        <TextView
                            style="@style/UmbraTextoSecundario"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:labelFor="@id/txtCarismaDetalle"
                            android:text="@string/detalle_carisma" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/txtEstadoDetalle"
            style="@style/UmbraTextoSecundario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:accessibilityLiveRegion="polite"
            android:gravity="center" />

        <Button
            android:id="@+id/btnEditarPersonaje"
            style="@style/UmbraBotonPrincipal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp"
            android:minHeight="56dp"
            android:text="@string/detalle_editar_personaje"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnEliminarPersonaje"
            style="@style/UmbraBotonEliminar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/detalle_eliminar_personaje"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnVolverDetalle"
            style="@style/UmbraBotonSecundario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/detalle_volver_biblioteca" />
    </LinearLayout>
</ScrollView>