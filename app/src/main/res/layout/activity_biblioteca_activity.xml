<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#101518"
    android:padding="20dp">

    <TextView
        android:id="@+id/tituloBiblioteca"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="@string/textview_BibliotecaUmbra"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txtEstado"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="@string/textview_pulsar_button_para_cargar"
        android:textColor="#C4CFD5" />

    <Button
        android:id="@+id/btnCargarPersonajes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/button_cargar_personajes" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerPersonajes"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingTop="8dp"
        android:paddingBottom="12dp" />

    <Button
        android:id="@+id/btnCrearPersonaje"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/button_crear_personaje"
        android:visibility="gone" />

    <Button
        android:id="@+id/btnVolver"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/button_volver_inicio" />

    <Button
        android:id="@+id/btnCerrarSesion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/button_cerrar_sesion"
        android:visibility="gone" />

    <Button
        android:id="@+id/btnIrLogin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/button_ir_login"
        android:visibility="gone" />

</LinearLayout>
