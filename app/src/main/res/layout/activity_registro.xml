<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/umbra_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            style="@style/UmbraTitulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="20dp"
            android:fontFamily="serif"
            android:gravity="center"
            android:letterSpacing="0.15"
            android:text="@string/app_name"
            android:textSize="32sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginBottom="24dp"
            android:background="@color/umbra_border" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/umbra_card_background"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                style="@style/UmbraTitulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:fontFamily="serif"
                android:gravity="center"
                android:text="@string/registro_titulo"
                android:textSize="26sp" />

            <TextView
                style="@style/UmbraTexto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:labelFor="@+id/etNombreRegistro"
                android:text="@string/registro_nombre" />

            <EditText
                android:id="@id/etNombreRegistro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:autofillHints="username"
                android:background="@drawable/umbra_input_background"
                android:imeOptions="actionNext"
                android:inputType="textPersonName"
                android:maxLength="50"
                android:minHeight="56dp"
                android:padding="16dp"
                android:singleLine="true"
                android:textColor="@color/umbra_text"
                android:textSize="16sp" />

            <TextView
                style="@style/UmbraTexto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:labelFor="@+id/etEmailRegistro"
                android:text="@string/registro_email" />

            <EditText
                android:id="@id/etEmailRegistro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:autofillHints="emailAddress"
                android:background="@drawable/umbra_input_background"
                android:imeOptions="actionNext"
                android:inputType="textEmailAddress"
                android:maxLength="100"
                android:minHeight="56dp"
                android:padding="16dp"
                android:singleLine="true"
                android:textColor="@color/umbra_text"
                android:textSize="16sp" />

            <TextView
                style="@style/UmbraTexto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:labelFor="@+id/etPasswordRegistro"
                android:text="@string/registro_password" />

            <EditText
                android:id="@id/etPasswordRegistro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autofillHints="newPassword"
                android:background="@drawable/umbra_input_background"
                android:imeOptions="actionNext"
                android:inputType="textPassword"
                android:maxLength="72"
                android:minHeight="56dp"
                android:padding="16dp"
                android:saveEnabled="false"
                android:singleLine="true"
                android:textColor="@color/umbra_text"
                android:textSize="16sp" />

            <TextView
                style="@style/UmbraTextoSecundario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="20dp"
                android:text="@string/registro_requisitos_password"
                android:textSize="13sp" />

            <TextView
                style="@style/UmbraTexto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:labelFor="@+id/etConfirmarPassword"
                android:text="@string/registro_confirmar_password" />

            <EditText
                android:id="@id/etConfirmarPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autofillHints="newPassword"
                android:background="@drawable/umbra_input_background"
                android:imeOptions="actionDone"
                android:inputType="textPassword"
                android:maxLength="72"
                android:minHeight="56dp"
                android:padding="16dp"
                android:saveEnabled="false"
                android:singleLine="true"
                android:textColor="@color/umbra_text"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/txtEstadoRegistro"
                style="@style/UmbraTextoSecundario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:accessibilityLiveRegion="polite"
                android:gravity="center" />

            <ProgressBar
                android:id="@+id/progresoRegistro"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:layout_marginTop="16dp"
                android:indeterminateTint="@color/umbra_primary"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnRegistrar"
                style="@style/UmbraBotonPrincipal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:minHeight="56dp"
                android:text="@string/registro_boton" />

            <Button
                android:id="@+id/btnVolverLogin"
                style="@style/UmbraBotonSecundario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:minHeight="48dp"
                android:text="@string/registro_volver" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
